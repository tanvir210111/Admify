# Admify Production Backend Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection (MongoDB with authentication enabled on 127.0.0.1)
# Replace <PASSWORD> with the password for the admifyApp database user
MONGODB_URI=mongodb://admifyApp:<PASSWORD>@127.0.0.1:27017/admify?authSource=admify

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_in_production
JWT_EXPIRE=30d

# Allowed Client Origins for CORS (comma separated)
CLIENT_URL=https://admify.world,https://www.admify.world,http://localhost:5173,http://localhost:3000

# Default Platform Admin Credentials (for seed script)
ADMIN_NAME=Admify Administrator
ADMIN_EMAIL=admin@admify.world
ADMIN_PASSWORD=Admin@123456
