# Admify Frontend Environment Variables
# Copy this file to .env for local development or production configuration

# Backend API Base URL
# For production on CloudPanel VPS (recommend subdomain):
# VITE_API_URL=https://api.admify.world
#
# For local development:
# VITE_API_URL=http://localhost:5001
VITE_API_URL=https://api.admify.world
