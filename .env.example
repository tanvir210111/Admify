# Admify Frontend Environment Variables
# Copy this file to .env for local development or production configuration

# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL (leave empty when hosting frontend statically before backend deployment)
VITE_API_URL=
